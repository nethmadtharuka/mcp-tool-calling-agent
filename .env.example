# LLM_PROVIDER=mock runs the app without any API key (dev/testing).
# Set LLM_PROVIDER=openai or LLM_PROVIDER=gemini (plus LLM_API_KEY) to use a real model.
LLM_PROVIDER=mock
#why we use mock chat model with also the OpenAI API,
#because when doing tests each and every time it costs
#there fore we use mock agent for testing
#LLM_PROVIDER=openai (here we can use Mock,for the testing as it does not costs when testing)

LLM_MODEL=gpt-5.6-luna
LLM_API_KEY= "Your OpenAI API key here"

# To use Gemini instead, set:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-lite-latest
# LLM_API_KEY="Your Google AI Studio API key here"

# Phase 3 - GitHub MCP.
# Fine-grained PAT, read-only, scoped to only the repos you want the agent
# to read. Never commit a real token - this file only holds a placeholder.
GITHUB_PERSONAL_ACCESS_TOKEN=your-fine-grained-pat-here
# Which GitHub MCP toolsets to expose (can only narrow the server's
# defaults). --read-only is hardcoded in docker-compose.yml, not
# configurable here, so it can't be disabled by mistake.
GITHUB_TOOLSETS=repos,issues,pull_requests

# Phase 4 - Filesystem MCP. Off by default (needs no secret, so it's an
# explicit opt-in); docker-compose.yml forces it on for the agent. The agent
# can read files in this project directory only - the :ro mounts live in
# docker-compose.yml and the read-only tool allowlist in
# app/agent/mcp_tools.py, neither configurable here.
FILESYSTEM_MCP_ENABLED=false

# Phase 7b - MCP server URLs. Defaults are the compose service names, so
# leave these unset under docker compose. For `python run.py` on the host
# with docker-compose.dev.yml running:
# GITHUB_MCP_URL=http://127.0.0.1:8082/
# FILESYSTEM_MCP_URL=http://127.0.0.1:8001/mcp
