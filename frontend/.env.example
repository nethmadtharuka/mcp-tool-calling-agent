# Copy to .env.local (git-ignored). Vite only exposes variables prefixed
# with VITE_ to the browser bundle, and everything in it is PUBLIC:
# never put API keys or tokens here. The LLM key and GitHub PAT stay on
# the backend.

# Backend base URL, no trailing slash, e.g. https://agent-api.example.com
# Leave empty in local dev: the dev server proxies /api and /health to
# VITE_DEV_PROXY_TARGET instead, so no CORS setup is needed.
# In production (Vercel) it must be set, and the backend must list the
# frontend's origin in CORS_ALLOW_ORIGINS.
VITE_API_BASE_URL=

# Dev/preview server only (vite.config.ts), never bundled.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
